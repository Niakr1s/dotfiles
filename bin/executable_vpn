#!/usr/bin/env bash

PORT=9999

VPN="$HOME/go/bin/xray-knife" # separate for kill
VPN_CMD="$VPN proxy system --port $PORT --rotate 300"

PROXY="mitmdump"
PROXY_CMD="$PROXY -p $PORT --ignore-hosts '.*'"

# Kills a proxy that listens on PORT
# $1: a binary name
kill_proxy() {
  local bin="$1"
  pkill -f "$bin.*$PORT"
}

# Kills both VPN and PROXY
killall() {
  kill_proxy "$VPN"
  kill_proxy "$PROXY"
}

# Returns 0 if it's on
# $1: a binary name
status() {
  local bin="$1"
  pgrep -f "^$bin.*$PORT" &>/dev/null
}

start_proxy() {
  killall
  eval "$PROXY_CMD &"
  echo "vpn off"
}

start_vpn() {
  killall
  eval "$VPN_CMD &"
}

toggle() {
  if status "$VPN"; then
    start_proxy
  else
    start_vpn
  fi
}

case "$1" in
  on)
    start_vpn
    ;;
  off)
    start_proxy 
    ;;
  kill)
    killall
    ;;
  status)
    if status $VPN; then
      echo "on"
    else
      echo "off"
    fi
    ;;
  toggle)
    toggle
    ;;
  *)
    echo "Usage: $0 {on|off|status}"
    ;;
esac
