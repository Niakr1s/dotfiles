# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Install oh-my-zsh if not installed
[ ! -d "$HOME/.oh-my-zsh" ] && sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="maran"

ENABLE_CORRECTION=true

plugins=(
  git
  zoxide
  fzf
)

source $ZSH/oh-my-zsh.sh

# Fixes for pagers
export LESS='-R'
export PAGER='less -R'
export GIT_PAGER='less -R'

# FZF config
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --exclude dosdevices --exclude drive_c --exclude .venv'
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {}' --walker-skip .git,node_modules,target,dosdevices,drive_c,.venv"
export FZF_ALT_C_OPTS="--preview 'tree -C {}' --walker-skip .git,node_modules,target,dosdevices,drive_c,.venv"

luksMountUmount() {
  local uuid="$1"
  local label="$2"
  local mountDir="/data/$label"

  eval "$(cat <<EOF
${label}() {
  sudo cryptsetup luksOpen /dev/disk/by-uuid/${uuid} "${label}"
  sudo mount /dev/mapper/"${label}" "${mountDir}"
}

${label}u() {
  sudo umount "${mountDir}"
  sudo cryptsetup luksClose "${label}"
}
EOF
  )"
}

luksMountUmount "5985a2f1-a9ab-4e9f-ae19-280685145e02" "hdd4"
