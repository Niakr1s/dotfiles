# Set your default proxy
PROXY_URL="${PROXY_URL:-http://127.0.0.1:9999}"
proxy-shell() {
    local p="${1:-$PROXY_URL}"
    echo "On: $p"
    http_proxy="$p" https_proxy="$p" HTTP_PROXY="$p" HTTPS_PROXY="$p" $SHELL
    echo "Off: $p"
}
