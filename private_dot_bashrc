# ~/.bashrc
# The individual per-interactive-shell startup file.

# Source global definitions.
if [ -r /etc/bashrc ]; then
	. /etc/bashrc
fi

export EDITOR="nvim"
export VISUAL="nvim"

alias y="yazi"

alias vim="nvim"

alias myip="curl ipinfo.io"

# Chezmoi
alias cz="chezmoi"
alias czcd="chezmoi cd"
alias cze="chezmoi edit"
alias czd="chezmoi diff"
alias czm="chezmoi merge"

# Git
alias gst="git status"
alias gd="git diff"
alias gds="git diff --staged"
alias gp="git push"
alias gl="git pull"
alias ga="git add"
alias gc="git commit"

# Eza
ezaCmd() {
	eza --group-directories-first --icons "$@"
}
ezaCmdTotal() {
	ezaCmd --total-size "$@"
}
alias l="ezaCmd -a";
alias ll="ezaCmd -l";
alias la="ezaCmd -la";
alias llt="ezaCmdTotal -l";
alias lat="ezaCmdTotal -la";
