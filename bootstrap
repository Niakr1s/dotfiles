confirm_yes_no() {
  # Usage: confirm_yes_no "Prompt text"
  # Returns: 0 if user types y or Y, 1 otherwise
  local prompt="$1"
  local suggestion="$2"
  local ans

  echo "$prompt (y): "
  read -r ans
  if [[ "$ans" == "y" ]]; then 
    [[ ! -z "$suggestion" ]] && echo "Suggestion:\n\t$suggestion"
    return 0
  fi
  return 1
}

bootstrap_postinstall_tips() {
  cat << EOF
PostInstall steps:
- Install tmux plugins: <prefix>+I
- Enable and configure syncthing: systemctl --user enable --now syncthing
- Download steam runtimes and link them to umu: bootstrap_link_steamruntime_to_umu
EOF
}

bootstrap_enable_kvantum() {
  install_pkgs kvantum kvantum-qt5
  kvantummanager --set KvGnomeDark
}

bootstrap_enable_snapper_home_snapshots() {
  sudo snapper -c home create-config /home
}

bootstrap_install_asdf_packages() {
  asdf plugin add zig
  asdf install zig "0.16.0"
  asdf plugin add zls
  asdf install zls "0.16.0"
}

bootstrap_enable_virtualization() {
  # https://wiki.cachyos.org/virtualization/qemu_and_vmm_setup/

  # This will install the needed packages (note the "Windows 11" note below):
  sudo pacman -S qemu-full virt-manager swtpm
  # Force libvirt to use iptables
  echo 'firewall_backend = "iptables"' | sudo tee -a /etc/libvirt/network.conf
  # This will add the user to the "libvirt" group so they can use it:
  sudo usermod -aG libvirt $USER
  # LXC backend (optional, for linux containers, enabling both backends does not conflict):
  systemctl enable --now libvirtd.service
  # QEMU backend (for VMs):
  systemctl enable --now libvirtd.socket
  # This will bring Internet up in a VM whenever one starts:
  sudo virsh net-autostart default
  # And to enable the entire VM network to have unfettered transit: (You should consider if you need more granular firewall rules based on your use case and security posture)
  sudo ufw route allow from 192.168.122.0/24
}

bootstrap_disable_sleep_hybernation() {
  echo "Disabling sleep and hybernation..."
  sudo systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target
}

bootstrap_install_switch_emulators() {
  echo "Installing Ryujinx..."
  am -i ryujinx

  echo "Downloading and install keys..."
  mkdir -p "$HOME/.config/Ryujinx/system"
  wget -O- "https://archive.org/download/20.0.1-keys/20.0.1 Keys.zip" | bsdtar -xf- -C "$HOME/.config/Ryujinx/system"

  echo "Downloading and installing cheats..."
  mkdir -p $HOME/.config/Ryujinx/mods
  wget -O- "https://github.com/HamletDuFromage/switch-cheats-db/releases/download/2026-04-18/contents_complete.zip" | bsdtar -xf- -C "$HOME/.config/Ryujinx/mods"

  echo "1" | am -i eden # choose '1) AMD64 (PGO)' variant
  echo "Downloading and install keys..."
  mkdir -p "$HOME/.local/share/eden/keys"
  wget -O- "https://archive.org/download/20.0.1-keys/20.0.1 Keys.zip" | bsdtar -xf- -C "$HOME/.local/share/eden/keys"

  cat << EOF
Eden configuration:
  - VULKAN BALANCED DOCKED SCALEFORCE SMAA
EOF

  local SWITCH_FIRMWARE_PATH="$HOME/.cache/SwitchFirmware.zip"
  if [[ ! -e "$SWITCH_FIRMWARE_PATH" ]]; then
    echo "Downloading firmware to ~/.cache..."
    wget -O "$SWITCH_FIRMWARE_PATH" "https://github.com/THZoria/NX_Firmware/releases/download/20.0.1/Firmware.20.0.1.zip"
  fi
  echo "Switch firmware is at $SWITCH_FIRMWARE_PATH, don't forget to install it"
}

bootstrap_install_playstation_emulators() {
  echo "Installing pcsx2"
  am -i pcsx2

  echo "Installing bioses..."
  mkdir -p "$HOME/.config/PCSX2/bios"
  for region in a e j h; do wget -O- "https://github.com/archtaurus/RetroPieBIOS/raw/refs/heads/master/BIOS/pcsx2/bios/ps2-0230${region}-20080220.bin" > "$HOME/.config/PCSX2/bios/ps2-0230${region}-20080220.bin"; done

  echo "Installing rpcs3"
  am -i rpcs3

  local PCS3_FIRMWARE_PATH="$HOME/.cache/PS3UPDAT.PUP"
  echo "Downloading PS3 firmware to $PCS3_FIRMWARE_PATH"
  wget -P "$PCS3_FIRMWARE_PATH" "http://dus01.ps3.update.playstation.net/update/ps3/image/us/2026_0318_a2b60b6ac1d2e49e230144345616927c/PS3UPDAT.PUP"
  echo "PS3 firmware is at $PCS3_FIRMWARE_PATH, don't forget to install it"

  echo "Installing ps3dec (tool for decrypting ps3 iso)..."
  cargo install --git https://github.com/Redrrx/ps3dec

  echo "Installing shadPS4..."
  am -i shadps4-qtlauncher

  echo "Installing azaharplus-pkg-extractor for shadPS4..."

  # appimage-download "shadPS4-PKGInstall" "https://github.com/Muggle345/PKGInstall/releases/download/Release/PKGInstall-linux-AppImage-2025-10-24-96c7890.zip"
  am -i azaharplus-pkg-extractor
}

bootstrap_install_xbox_emulators() {
  echo "Installing xemu..."
  am -i xemu
  mkdir -p "$HOME/.local/share/xemu"
  wget -O- "https://archive.org/download/xemustarter/XEMU FILES.zip" | bsdtar -xf- -C "$HOME/.local/share/xemu"
  echo "Needed xemu fiiles are under $HOME/.local/share/xemu, provide it to emulator them manually"
}

bootstrap_install_retroarch() {
  echo "Installing retroarch..."
  echo "Refer to docs/retroarch.md for further configuration"
  am -i retroarch

  echo "Removing portable home for retroarch to use usual directories.."
  sudo rm -rf /opt/retroarch/retroarch.home
  mkdir -p ~/.config/retroarch
}

bootstrap_link_steamruntime_to_umu() {
  confirm_yes_no "Make sure you've downloaded all 4 steam linux runtimes first (under tools section)."
  rm -rf ~/.local/share/umu/steamrt*
  ln -s ~/.local/share/Steam/steamapps/common/SteamLinuxRuntime ~/.local/share/umu/steamrt1
  ln -s ~/.local/share/Steam/steamapps/common/SteamLinuxRuntime ~/.local/share/umu/steamrt # dunno if it with prefix 1
  ln -s ~/.local/share/Steam/steamapps/common/SteamLinuxRuntime_soldier ~/.local/share/umu/steamrt2
  ln -s ~/.local/share/Steam/steamapps/common/SteamLinuxRuntime_sniper ~/.local/share/umu/steamrt3
  ln -s ~/.local/share/Steam/steamapps/common/SteamLinuxRuntime_4 ~/.local/share/umu/steamrt4
}

bootstrap_install_nvidia_container_toolkit() {
  install_pkgs nvidia-container-toolkit
  sudo nvidia-ctk runtime configure --runtime=docker
  sudo systemctl restart docker
}

bootstrap_install_sunshine() {
  install_pkgs sunshine

  echo "Enabling firewall for sunshine..."
  sudo tee /etc/ufw/applications.d/sunshine << EOF
[sunshine]
title=Sunshine
description=Sunshine
ports=47984,47989,48010/tcp|47998:48010/udp
EOF
  sudo ufw allow Sunshine
}

bootstrap_install_ai_tools() {
  which llama || curl -LsSf https://llama.app/install.sh | sh
  which pi || curl -fsSL https://pi.dev/install.sh | sh
  pi install git:github.com/huggingface/pi-llama

  confirm_yes_no "Download models?" && {
    llama download -hf ggml-org/gemma-4-12B-it-GGUF:Q4_0
  }
}

bootstrap_manage_limine_kernel_params() {
  local LIMINE_FILE="/etc/default/limine"
  local BEGIN_MARKER="# BEGIN MANAGED BLOCK - DO NOT EDIT MANUALLY"
  local END_MARKER="# END MANAGED BLOCK"

  # local BLOCK_CONTENT='KERNEL_CMDLINE[default]+=clearcpuid=514 split_lock_detect=off usbcore.quirks="057e:2009:ik"'
  local BLOCK_CONTENT=$(cat << EOF
# Fixes freezes and crashes in games
KERNEL_CMDLINE[default]+=clearcpuid=514 split_lock_detect=off
# Fixes my wired gamepad
KERNEL_CMDLINE[default]+=usbcore.quirks="057e:2009:ik"
EOF
)

  # Check if file exists
  if [[ ! -f "$LIMINE_FILE" ]]; then
    echo "❌ Error: $LIMINE_FILE does not exist"
    return 1
  fi

  echo "Before:"
  cat "$LIMINE_FILE"
  echo ""

  # Check if the managed block exists
  if grep -q "^${BEGIN_MARKER}" "$LIMINE_FILE" && grep -q "^${END_MARKER}" "$LIMINE_FILE"; then
    # Get line numbers
    local START_LINE=$(sudo grep -n "^${BEGIN_MARKER}" "$LIMINE_FILE" | head -1 | cut -d: -f1)
    local END_LINE=$(sudo grep -n "^${END_MARKER}" "$LIMINE_FILE" | head -1 | cut -d: -f1)

    # Delete everything between BEGIN and END markers (inclusive)
    sudo sed -i "${START_LINE},${END_LINE}d" "$LIMINE_FILE"
  fi

  # Add the entire managed block at the end
  {
    echo "${BEGIN_MARKER}"
    echo "${BLOCK_CONTENT}"
    echo "${END_MARKER}"
  } | sudo tee -a "$LIMINE_FILE" > /dev/null

  echo "After:"
  cat "$LIMINE_FILE"
  echo ""

  # Regenerate bootloader configuration
  echo "Regenerating Limine configuration with limine-mkinitcpio..."
  sudo limine-mkinitcpio && echo "Done!" || echo "Error"
}

bootstrap_main() {
  # Define all tasks with their descriptions and commands
  # Lines starting with '# ' are section headers and won't be selectable
  local tasks=(
    "# Packages"
    "Install packages|install_pkgs \"\${PKGS[@]}\""
    "Install aur packages|install_pkgs_aur \"\${PKGS_AUR[@]}\""
    "Install am packages|install_pkgs_am \"\${PKGS_AM[@]}\""
    "Install gaming packages|sudo cachyos-hello fix install-gaming"
    "Install asdf packages|bootstrap_install_asdf_packages"
    "Install ai tools|bootstrap_install_ai_tools"
    "Install sunshine|bootstrap_install_sunshine"

    "# System"
    "Rank mirrors|sudo cachyos-hello fix rank-mirrors"
    "Append essential kernel boot params to limine|bootstrap_manage_limine_kernel_params"
    "Disable sleep and hibernation|bootstrap_disable_sleep_hybernation"
    "Enable home snapper snapshots|bootstrap_enable_snapper_home_snapshots"
    
    "# Desktop Environment & Shell"
    "Install dankmaterialshell (niri & alacritty)|curl -fsSL https://install.danklinux.com | sh"
    "Enable kvantum theme|bootstrap_enable_kvantum"
    "Enable zsh as default shell|chsh -s /bin/zsh"

    "# Virtualization"
    "Enable virtualization|bootstrap_enable_virtualization"
    "Enable docker and install winboat|sudo cachyos-hello fix install-winboat"
    "Enable nvidia-container-toolkit for docker|bootstrap_install_nvidia_container_toolkit"

    "# Emulators"
    "Install switch emulators|bootstrap_install_switch_emulators"
    "Install playstation emulators|bootstrap_install_playstation_emulators"
    "Install xbox emulators|bootstrap_install_xbox_emulators"
    "Install retroarch|bootstrap_install_retroarch"
  )

  local selected_indices=()
  local total_tasks=${#tasks[@]}
  
  while true; do
    clear
  
    echo "📋 Select tasks to run (enter numbers separated by spaces, or 'all')"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    local display_num=0
    for i in $(seq 1 $total_tasks); do
      local item="${tasks[$i]}"
      
      # Check if it's a header
      if [[ "$item" == "# "* ]]; then
        local header="${item#\# }"
        echo ""
        echo "━━━ $header ━━━"
        echo ""
        continue
      fi
      
      # It's a task, increment display number
      ((display_num++))
      local desc=$(echo "$item" | cut -d'|' -f1)
      
      # Check if index is in selected_indices
      local is_selected=0
      for sel in "${selected_indices[@]}"; do
        if [[ $sel -eq $i ]]; then
          is_selected=1
          break
        fi
      done
      
      if [[ $is_selected -eq 1 ]]; then
        echo "[✓] $display_num. $desc"
      else
        echo "[ ] $display_num. $desc"
      fi
    done
    
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Options:"
    echo "  - Enter numbers: 1 3 5  (toggle selection)"
    echo "  - Type 'all' to select everything"
    echo "  - Type 'clear' to clear all selections"
    echo "  - Type 'done' to execute selected tasks"
    echo "  - Type 'quit' to exit"
    echo ""
    read "choice?Enter choice: "
    
    case "$choice" in
      all)
        # Select all non-header items
        selected_indices=()
        for i in $(seq 1 $total_tasks); do
          if [[ ! "${tasks[$i]}" == "# "* ]]; then
            selected_indices+=($i)
          fi
        done
        ;;
      clear)
        selected_indices=()
        ;;
      done)
        break
        ;;
      quit|q)
        echo "❌ Exiting..."
        return 0
        ;;
      *)
        # Parse space-separated numbers properly
        if [[ -n "$choice" ]]; then
          # Split by spaces and process each number
          local nums=(${(s: :)choice})
          for num in "${nums[@]}"; do
            if [[ "$num" =~ ^[0-9]+$ ]]; then
              # Find the actual index for this display number
              local actual_index=0
              local display_counter=0
              for i in $(seq 1 $total_tasks); do
                if [[ ! "${tasks[$i]}" == "# "* ]]; then
                  ((display_counter++))
                  if [[ $display_counter -eq $num ]]; then
                    actual_index=$i
                    break
                  fi
                fi
              done
              
              if [[ $actual_index -gt 0 ]]; then
                # Toggle selection
                local found=0
                local new_selected=()
                for sel in "${selected_indices[@]}"; do
                  if [[ $sel -eq $actual_index ]]; then
                    found=1
                  else
                    new_selected+=($sel)
                  fi
                done
                if [[ $found -eq 0 ]]; then
                  new_selected+=($actual_index)
                fi
                selected_indices=($new_selected)
              else
                echo "⚠️  Invalid number: $num"
                sleep 1
              fi
            else
              echo "⚠️  Invalid input: $num (must be a number)"
              sleep 1
            fi
          done
          # Sort selections
          selected_indices=($(printf "%s\n" "${selected_indices[@]}" | sort -n 2>/dev/null))
        fi
        ;;
    esac
  done

  # If nothing selected, exit
  if [[ ${#selected_indices[@]} -eq 0 ]]; then
    echo "❌ No tasks selected. Exiting."
    return 0
  fi

  echo ""
  echo "🚀 Executing ${#selected_indices[@]} selected tasks..."
  echo ""
  
  local task_count=0
  local total_selected=${#selected_indices[@]}
  for idx in "${selected_indices[@]}"; do
    ((task_count++))
    local task_info="${tasks[$idx]}"
    local task_desc=$(echo "$task_info" | cut -d'|' -f1)
    local task_cmd=$(echo "$task_info" | cut -d'|' -f2-)
    
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "[$task_count/$total_selected] ▶  Running: $task_desc"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    # Execute the command
    eval "$task_cmd"
    
    if [[ $? -eq 0 ]]; then
      echo "✅ Completed: $task_desc"
    else
      echo "❌ Failed: $task_desc"
    fi
    echo ""
    
    if [[ $task_count -lt $total_selected ]]; then
      read "continue?Press Enter to continue to next task..."
    fi
  done

  # Show postinstall tips
  bootstrap_postinstall_tips
}
