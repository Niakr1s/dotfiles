# Download and add a desktop entry
# Usage: appimage-install app <url>
appimage-install() {
  APPNAME=$1
  APPURL=$2

  wget -O ~/appimage/$APPNAME "$APPURL"
  appimage-desktop-entry.sh ~/appimage/$APPNAME
}
