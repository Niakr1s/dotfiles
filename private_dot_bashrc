# Eza
ezaCmd() {
	eza --group-directories-first --icons "$@"
}
ezaCmdTotal() {
	ezaCmd --total-size "$@"
}
alias l="ezaCmd -a"
alias ll="ezaCmd -l"
alias la="ezaCmd -la"
alias latree="ezaCmd -la --tree"
alias llt="ezaCmdTotal -l"
alias lat="ezaCmdTotal -la"
alias lattree="ezaCmdTotal -la --tree"

