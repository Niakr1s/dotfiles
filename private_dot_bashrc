# ~/.bashrc
# The individual per-interactive-shell startup file.
#
# There are 3 different types of shells in bash: the login shell, normal shell
# and interactive shell. Login shells read ~/.profile and interactive shells
# read ~/.bashrc; in our setup, /etc/profile sources ~/.bashrc - thus all
# settings made here will also take effect in a login shell.
#
# NOTE: It is recommended to make language settings in ~/.profile rather than
# here, since multilingual X sessions would not work properly if LANG is over-
# ridden in every subshell.

test -s ~/.alias && . ~/.alias || true

# Enable zypper concurrent downloader
export ZYPP_MEDIANETWORK=1

# Source global definitions.
if [ -r /etc/bashrc ]; then
	. /etc/bashrc
fi

BOOTSTRAP_FILEPATH="$HOME/.local/share/chezmoi/bootstrap"
# Source global definitions.
if [ -r "$BOOTSTRAP_FILEPATH" ]; then
	. "$BOOTSTRAP_FILEPATH"
fi

PATH_ADDITIONS=(
    "$HOME/node_modules/.bin"
    "$HOME/go/bin"
    "$HOME/.cargo/bin"
    "$HOME/.asdf/shims"
    "$HOME/Applications"
    "$HOME/bin"
)
export PATH="$PATH:$(IFS=:; echo "${PATH_ADDITIONS[*]}")"

export EDITOR="nvim"
export VISUAL="nvim"

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

alias zp="sudo zypper"
alias zpi="sudo zypper install"
alias zpr="sudo zypper remove -u"
alias zpu="sudo zypper refresh && sudo zypper dup"
function zps() {
  echo "Searching in zypper..."
  zypper search "$@"

  echo
  echo "Searching in am..."
  for pkg in "$@"; do
    am -q --all "$pkg"
  done
}

# Chezmoi
alias cz="chezmoi"
alias cza="chezmoi apply"
alias cze="chezmoi edit"
alias czd="chezmoi diff"
alias czs="chezmoi status"
alias czm="chezmoi merge-all"

# Git
alias gst="git status"
alias gd="git diff"
alias gds="git diff --staged"
alias gp="git push"
alias gl="git pull"
alias ga="git add"
alias gc="git commit"

# Eza
ezaCmd() {
	eza --group-directories-first --icons "$@"
}
ezaCmdTotal() {
	ezaCmd --total-size "$@"
}
alias l="ezaCmd -a";
alias ll="ezaCmd -l";
alias la="ezaCmd -la";
alias llt="ezaCmdTotal -l";
alias lat="ezaCmdTotal -la";

# Fixes for pagers
export LESS='-R'
export PAGER='less -R'
export GIT_PAGER='less -R'

# FZF config
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --exclude dosdevices --exclude drive_c --exclude .venv'
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {}' --walker-skip .git,node_modules,target,dosdevices,drive_c,.venv"
export FZF_ALT_C_OPTS="--preview 'tree -C {}' --walker-skip .git,node_modules,target,dosdevices,drive_c,.venv"

# Mount
luksMountUmount() {
  local uuid="$1"
  local label="$2"
  local mountDir="/data/$label"

  eval "$(cat <<EOF
${label}() {
  sudo cryptsetup luksOpen /dev/disk/by-uuid/${uuid} "${label}"
  sudo mount /dev/mapper/"${label}" "${mountDir}"
}

${label}u() {
  sudo umount "${mountDir}"
  sudo cryptsetup luksClose "${label}"
}
EOF
  )"
}

