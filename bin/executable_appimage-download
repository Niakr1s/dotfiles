#!/usr/bin/env bash


usage() {
  cat << EOF
# Download and appimage
# Works even with an appimage inside an archive, if it a single file
# Usage: appimage-download app <url>
EOF
}

APPNAME=$1
APPURL=$2
APPDIR=$HOME/Applications

mkdir -p $APPDIR

if [[ "$APPURL" == *.zip ]]; then
  wget -O- "$APPURL" | zcat > "$APPDIR/$APPNAME"
else
  wget -O "$APPDIR/$APPNAME" "$APPURL"
fi

chmod +x $APPDIR/$APPNAME
